---
import { Image } from "astro:assets";
import translationIcon from "../assets/translation.svg";
import enFlag from "../assets/flags/en.svg";
import srFlag from "../assets/flags/sr.svg";
import ruFlag from "../assets/flags/ru.svg";
import ptBrFlag from "../assets/flags/pt-br.svg";
import {
  homeUrl,
  languages,
  translations,
  type Locale,
  type LocalizedLink,
} from "../i18n";

interface Props {
  lang: Locale;
  alternates?: LocalizedLink[];
}
const { lang, alternates } = Astro.props;
const t = translations[lang];
const flags = { en: enFlag, sr: srFlag, ru: ruFlag, "pt-br": ptBrFlag };
---

<details class="LanguageSelector" data-language-selector>
  <summary class="LanguageSelector-button">
    <Image
      layout="none"
      loading="eager"
      class="LanguageSelector-icon"
      src={translationIcon}
      alt=""
    />
    <span class="LanguageSelector-text">{t.language}</span>
  </summary>
  <nav class="LanguageSelector-menu" aria-label={t.language}>
    {languages.map(({ code, label }) => (
      <a
        href={
          alternates?.find((link) => link.lang === code)?.href ?? homeUrl(code)
        }
        lang={code}
        hreflang={code}
        aria-current={code === lang ? "page" : undefined}
        class:list={[
          "LanguageSelector-link",
          { "LanguageSelector-link--current": code === lang },
        ]}
      >
        <Image
          layout="none"
          loading="eager"
          class="LanguageSelector-flag"
          src={flags[code]}
          alt=""
        />
        {label}
      </a>
    ))}
  </nav>
</details>

<script>
  document
    .querySelectorAll<HTMLDetailsElement>("[data-language-selector]")
    .forEach((selector) => {
      const summary = selector.querySelector("summary");

      selector.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && selector.open) {
          selector.open = false;
          summary?.focus();
          event.preventDefault();
        }
      });

      selector.addEventListener("focusout", (event) => {
        if (
          event.relatedTarget instanceof Node &&
          !selector.contains(event.relatedTarget)
        ) {
          selector.open = false;
        }
      });

      document.addEventListener("click", (event) => {
        if (event.target instanceof Node && !selector.contains(event.target))
          selector.open = false;
      });
    });
</script>
