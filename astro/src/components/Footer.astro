---
import { homeUrl, livePageUrl, translations, type Locale } from '../i18n';

interface Props { lang: Locale; isHome?: boolean }
const { lang, isHome = false } = Astro.props;
const t = translations[lang];
---

<footer class="Footer">
  <div class="Container">
    <p>{t.footerText}</p>
    <nav class="Footer-nav">
      {!isHome && <a href={homeUrl(lang)}>{t.homeLinkText}</a>}
      <a href={livePageUrl(lang, t.aboutLink)}>{t.aboutText}</a>
    </nav>
    <!-- These strings contain the existing, trusted license link. -->
    <p class="Footer-license" set:html={t.footerCopyright} />
  </div>
</footer>
