---
import { homeUrl, translations, type Locale } from "../i18n";

interface Props {
  lang: Locale;
  previous?: string;
  next?: string;
}
const { lang, previous, next } = Astro.props;
const t = translations[lang];
---

<nav class="Pagination" aria-label={`${t.prevLinkText} / ${t.nextLinkText}`}>
  {previous && (
    <a
      class="Pagination-link Pagination-link--prev"
      href={previous}
      rel="prev"
      title={t.prevLinkText}
      aria-label={t.prevLinkText}
    >
      &laquo;
    </a>
  )}
  {!previous && <div class="Pagination-placeholder" />}
  <div class="Pagination-imageWrapper">
    <a
      href={homeUrl(lang)}
      class="Pagination-homeLink"
      title={t.homeLinkText}
      aria-label={t.homeLinkText}
    >
      <img src="/img/letter.png" alt="" />
    </a>
  </div>
  {next && (
    <a
      class="Pagination-link Pagination-link--next"
      href={next}
      rel="next"
      title={t.nextLinkText}
      aria-label={t.nextLinkText}
    >
      &raquo;
    </a>
  )}
  {!next && <div class="Pagination-placeholder" />}
</nav>
