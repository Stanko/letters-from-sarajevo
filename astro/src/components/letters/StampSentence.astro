---
import StampImage from "./StampImage.astro";
import type { LetterData } from "../../lib/book";
interface Props {
  parts: Extract<LetterData, { template: "letter-three" }>["header"];
}
const { parts } = Astro.props;
---

{parts.map((part) => (
  <Fragment>
    {typeof part === "string" && part}
    {typeof part !== "string" && <StampImage stamp={part} />}{" "}
  </Fragment>
))}
