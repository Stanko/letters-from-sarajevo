---
import LanguageSelector from './LanguageSelector.astro';
import { homeUrl, translations, type Locale } from '../i18n';

interface Props { lang: Locale; title: string }
const { lang, title } = Astro.props;
---

<header class="Navigation">
  <nav class="Navigation-content">
    <a class="Navigation-link" href={homeUrl(lang)}>{translations[lang].title}</a>
    <span class="Navigation-separator" aria-hidden="true">&bull;</span>
    <span class="Navigation-title">{title}</span>
    <LanguageSelector lang={lang} />
  </nav>
</header>
