---
import { Image } from "astro:assets";
import letterImage from "../assets/letter-color1.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";
import LanguageSelector from "./LanguageSelector.astro";
import { translations, type Locale } from "../i18n";
import { entryUrl, getBookEntries, getBookEntry } from "../lib/book";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = translations[lang];
const firstLetter = getBookEntry(await getBookEntries(), lang, "letter-1");
---

<BaseLayout lang={lang} isHome>
  <div class="Home">
    <div class="Home-content">
      <div class="Home-top">
        <div class="Home-topContent Container">
          <div>
            <h1 class="Home-title">{t.home.title}</h1>
            <div class="Home-author">{t.home.author}</div>
          </div>
          <LanguageSelector lang={lang} />
        </div>
      </div>
      <div class="Container">
        {t.home.paragraphs.map((paragraph) => (
          <p class="Home-text">{paragraph}</p>
        ))}
        <p class="Home-dedication">{t.home.dedication}</p>
      </div>
    </div>
    <div class="Container">
      <a class="Home-start" href={entryUrl(firstLetter)}>
        <span class="Home-startText">{t.firstLetterText}</span>
        <Image layout="none" class="Home-startImage" src={letterImage} alt="" />
      </a>
    </div>
  </div>
</BaseLayout>
