---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import {
  canonicalHomeUrl,
  homeUrl,
  languages,
  siteOrigin,
  translations,
  type Locale,
  type LocalizedLink,
} from "../i18n";
import "../styles/index.scss";

interface Props {
  lang: Locale;
  title?: string;
  isHome?: boolean;
  canonical?: string;
  alternates?: LocalizedLink[];
  noindex?: boolean;
}

const {
  lang,
  title,
  isHome = false,
  canonical,
  alternates,
  noindex = false,
} = Astro.props;
let alternateLinks = alternates ?? [];
if (!alternates && isHome) {
  alternateLinks = languages.map(({ code }) => ({
    lang: code,
    href: homeUrl(code),
    canonical: canonicalHomeUrl(code),
  }));
}
const defaultAlternate = alternateLinks.find((link) => link.lang === "en");
const t = translations[lang];
const pageTitle = title ? `${t.title} · ${title}` : t.title;
const pageUrl =
  canonical ??
  (isHome
    ? canonicalHomeUrl(lang)
    : new URL(Astro.url.pathname, siteOrigin(lang)).href);
const imageUrl = new URL(`/img/${t.metaImage}`, siteOrigin(lang)).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={t.metaDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={pageUrl} />
    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={link.canonical} />
    ))}
    {defaultAlternate && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={defaultAlternate.canonical}
      />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={t.metaDescription} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={t.metaDescription} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css?family=Patrick+Hand+SC&display=swap&subset=latin-ext"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Merriweather:ital,opsz,wght@0,18..144,300..900;1,18..144,300..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,200..900;1,7..72,200..900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css?family=Pangolin&display=swap"
    />
    {lang === "el" && (
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Mynerve&display=swap"
      />
    )}
    {lang === "zh" && (
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Noto+Serif+SC:wght@300;400&display=swap"
      />
    )}
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/img/favicon/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/img/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/img/favicon/favicon-16x16.png"
    />
    <link rel="shortcut icon" href="/img/favicon/favicon.ico" />
    <link
      rel="manifest"
      href={`/img/favicon/site${lang === "sr" ? ".sr" : ""}.webmanifest`}
    />
    <link
      rel="mask-icon"
      href="/img/favicon/safari-pinned-tab.svg"
      color="#2b5797"
    />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body>
    <div class="Wrapper">
      <Navigation lang={lang} title={title} alternates={alternateLinks} />
      <main class="Content">
        <slot />
      </main>
      <Footer lang={lang} isHome={isHome} alternates={alternateLinks} />
    </div>
  </body>
</html>
