---
import {
  homeUrl,
  languages,
  siteOrigin,
  translations,
  type Locale,
} from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBookEntries, getBookEntry } from "../lib/book";
import Envelope from "./Envelope.astro";
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = translations[lang];
const firstLetter = getBookEntry(await getBookEntries(), lang, "letter-1");
const alternates = languages.map(({ code }) => ({
  lang: code,
  href: `/${code}/404/`,
  canonical: new URL(`/${code}/404/`, siteOrigin(code)).href,
}));
---

<BaseLayout lang={lang} title={t.error404} noindex alternates={alternates}>
  <div class="NotFound">
    <h1>{t.error404}</h1>
    <p>{t.pageNotFound}</p>
    <a href={homeUrl(lang)}>{t.homeLinkText}</a>
  </div>
  <div class="Container">
    <Envelope lang={lang} />
  </div>
</BaseLayout>
