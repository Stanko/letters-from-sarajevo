---
import { Image } from "astro:assets";
import letter from "../assets/letter.png";
import { translations, type Locale } from "../i18n";
import { entryPath, entryUrl, getBookEntries, getBookEntry } from "../lib/book";
import { readingOrder } from "../lib/reading-order";

interface Props {
  lang: Locale;
  id?: string;
  className?: string;
  buttonClassName?: string;
}

const {
  lang,
  id = "letters",
  className = "",
  buttonClassName = "Navigation-item",
} = Astro.props;
const t = translations[lang];
const entries = await getBookEntries();
const letters = readingOrder.map((key) => getBookEntry(entries, lang, key));
---

<div class:list={["LetterNavigation", className]} data-letter-navigation>
  <button
    id={`${id}-button`}
    class={buttonClassName}
    type="button"
    title={t.allLetters}
    aria-label={t.allLetters}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls={`${id}-menu`}
  >
    <slot>
      {t.allLetters}{" "}
      <Image
        decoding="sync"
        layout="none"
        loading="eager"
        src={letter}
        alt=""
      />
    </slot>
  </button>
  <nav
    id={`${id}-menu`}
    class="LetterNavigation-menu"
    aria-label={t.allLetters}
    hidden
  >
    {letters.map((entry) => (
      <a
        class="LetterNavigation-link"
        href={entryUrl(entry)}
        aria-current={
          Astro.url.pathname.replace(/\/$/, "") ===
          entryPath(entry).replace(/\/$/, "")
            ? "page"
            : undefined
        }
      >
        {entry.data.title}
      </a>
    ))}
  </nav>
  <noscript>
    <style is:inline>
      .LetterNavigation-menu[hidden] {
        display: flex;
        position: static;
        transform: none;
      }
      [data-letter-navigation] > button {
        display: none;
      }
    </style>
  </noscript>
</div>

<script>
  import { initDropdown } from "../scripts/dropdown";

  document
    .querySelectorAll<HTMLElement>("[data-letter-navigation]")
    .forEach(initDropdown);
</script>
