---
import { Image } from "astro:assets";
import Dropdown from "./Dropdown.astro";
import letter from "../assets/letter.png";
import { translations, type Locale } from "../i18n";
import { entryPath, entryUrl, getBookEntries, getBookEntry } from "../lib/book";
import { readingOrder } from "../lib/reading-order";

interface Props {
  lang: Locale;
  id?: string;
  className?: string;
  buttonClassName?: string;
}

const {
  lang,
  id = "letters",
  className = "",
  buttonClassName = "Navigation-item",
} = Astro.props;
const t = translations[lang];
const entries = await getBookEntries();
const letters = readingOrder.map((key) => getBookEntry(entries, lang, key));
---

<Dropdown
  id={id}
  label={t.allLetters}
  className={`LetterNavigation ${className}`}
  buttonClassName={buttonClassName}
  menuClassName="LetterNavigation-menu"
  buttonTitle={t.allLetters}
  buttonLabel={t.allLetters}
>
  <Fragment slot="button">
    <slot>
      {t.allLetters}{" "}
      <Image
        decoding="sync"
        layout="none"
        loading="eager"
        src={letter}
        alt=""
      />
    </slot>
  </Fragment>
  {letters.map((entry) => (
    <a
      class="Dropdown-link LetterNavigation-link"
      href={entryUrl(entry)}
      aria-current={
        Astro.url.pathname.replace(/\/$/, "") ===
        entryPath(entry).replace(/\/$/, "")
          ? "page"
          : undefined
      }
    >
      {entry.data.title}
    </a>
  ))}
</Dropdown>
