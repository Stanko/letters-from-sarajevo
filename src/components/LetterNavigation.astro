---
import { Image } from "astro:assets";
import letter from "../assets/letter.png";
import { translations, type Locale } from "../i18n";
import { entryPath, entryUrl, getBookEntries, getBookEntry } from "../lib/book";
import { readingOrder } from "../lib/reading-order";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang];
const entries = await getBookEntries();
const letters = readingOrder.map((key) => getBookEntry(entries, lang, key));
---

<div class="LetterNavigation" data-letter-navigation>
  <button
    id="letters-button"
    class="Navigation-item"
    type="button"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="letters-menu"
  >
    {t.allLetters} <Image layout="none" src={letter} alt="" />
  </button>
  <nav
    id="letters-menu"
    class="LetterNavigation-menu"
    aria-label={t.allLetters}
    hidden
  >
    {letters.map((entry) => (
      <a
        class="LetterNavigation-link"
        href={entryUrl(entry)}
        aria-current={
          Astro.url.pathname.replace(/\/$/, "") ===
          entryPath(entry).replace(/\/$/, "")
            ? "page"
            : undefined
        }
      >
        {entry.data.title}
      </a>
    ))}
  </nav>
  <noscript>
    <style is:inline>
      #letters-menu[hidden] {
        display: flex;
        position: relative;
      }
      #letters-button {
        display: none;
      }
    </style>
  </noscript>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-letter-navigation]")
    .forEach((selector) => {
      const button = selector.querySelector("button");
      const menu = selector.querySelector("nav");

      if (!button || !menu) {
        return;
      }

      const links = Array.from(menu.querySelectorAll("a"));

      const setExpanded = (expanded: boolean) => {
        if (!expanded && menu.contains(document.activeElement)) {
          button.focus();
        }

        button.setAttribute("aria-expanded", String(expanded));
        menu.hidden = !expanded;
      };

      menu.setAttribute("role", "menu");
      menu.setAttribute("aria-labelledby", button.id);
      links.forEach((link) => {
        link.setAttribute("role", "menuitem");
        link.tabIndex = -1;
        link.addEventListener("click", () => setExpanded(false));
      });

      setExpanded(false);

      button.addEventListener("click", () => {
        const expanded = button.getAttribute("aria-expanded") === "false";
        setExpanded(expanded);

        if (expanded) {
          links[0]?.focus();
        }
      });

      button.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          setExpanded(true);
          const index = event.key === "ArrowUp" ? links.length - 1 : 0;
          links[index]?.focus();
        }
      });

      menu.addEventListener("keydown", (event) => {
        if (event.ctrlKey || event.altKey || event.metaKey) {
          return;
        }

        if (event.key === "Escape" || event.key === "Tab") {
          setExpanded(false);

          if (event.key === "Escape" || event.shiftKey) {
            event.preventDefault();
          }
          return;
        }

        const index = links.findIndex(
          (link) => link === document.activeElement,
        );

        if (event.key === " ") {
          event.preventDefault();
          links[index]?.click();
          return;
        }

        let nextIndex = index;

        if (event.key === "ArrowDown") {
          nextIndex = (index + 1) % links.length;
        } else if (event.key === "ArrowUp") {
          nextIndex = (index - 1 + links.length) % links.length;
        } else if (event.key === "Home") {
          nextIndex = 0;
        } else if (event.key === "End") {
          nextIndex = links.length - 1;
        } else {
          return;
        }

        event.preventDefault();
        links[nextIndex]?.focus();
      });

      selector.addEventListener("focusout", (event) => {
        if (
          event.relatedTarget instanceof Node &&
          !selector.contains(event.relatedTarget)
        ) {
          setExpanded(false);
        }
      });

      document.addEventListener("click", (event) => {
        if (event.target instanceof Node && !selector.contains(event.target))
          setExpanded(false);
      });
    });
</script>
