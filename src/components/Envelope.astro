---
import { Image } from "astro:assets";
import backImage from "../assets/back.png";
import frontImage from "../assets/front.png";
import paperImage from "../assets/paper.png";
import { translations, type Locale } from "../i18n";
import { entryUrl, getBookEntries, getBookEntry } from "../lib/book";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = translations[lang];
const firstLetter = getBookEntry(await getBookEntries(), lang, "letter-1");
---

<a class="Envelope" href={entryUrl(firstLetter)}>
  <Image layout="none" class="Envelope-back" src={backImage} alt="" />
  <span class="Envelope-paperWrapper">
    <span class="Envelope-text">{t.startReading}</span>
    <Image layout="none" class="Envelope-paper" src={paperImage} alt="" />
  </span>
  <Image layout="none" class="Envelope-front" src={frontImage} alt="" />
</a>

<noscript>
  <style>
    .Envelope {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const envelope = document.querySelector(".Envelope") as HTMLLinkElement;
  const images = [
    ...document.querySelectorAll(".Envelope img"),
  ] as HTMLImageElement[];
  let loaded = 0;
  const check = () => {
    loaded++;
    if (loaded === images.length) {
      envelope.classList.add("Envelope-show");
    }
  };
  images.map((img) => {
    if (img.complete) {
      check();
    } else {
      img.addEventListener("load", check);
      img.addEventListener("error", check);
    }
  });
</script>
