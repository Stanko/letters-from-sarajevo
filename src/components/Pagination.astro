---
import { Image } from "astro:assets";
import letterImage from "../assets/letter.png";
import { translations, type Locale } from "../i18n";
import LetterNavigation from "./LetterNavigation.astro";

interface Props {
  lang: Locale;
  previous?: string;
  next?: string;
  previousTitle?: string;
  nextTitle?: string;
  position?: number;
  total?: number;
}
const { lang, previous, next, previousTitle, nextTitle, position, total } =
  Astro.props;
const t = translations[lang];
---

<nav class="Pagination" aria-label={`${t.prevLinkText} / ${t.nextLinkText}`}>
  {previous && (
    <a
      class="Pagination-link Pagination-link--prev"
      href={previous}
      rel="prev"
      title={previousTitle ?? t.prevLinkText}
      aria-label={previousTitle ?? t.prevLinkText}
    >
      <span aria-hidden="true">&larr;</span>
      <span class="Pagination-title">{previousTitle ?? t.prevLinkText}</span>
    </a>
  )}
  {!previous && <div class="Pagination-placeholder" />}
  <LetterNavigation
    lang={lang}
    id="pagination-letters"
    className="Pagination-letters"
    buttonClassName="Pagination-lettersButton"
  >
    <Image layout="none" loading="eager" src={letterImage} alt="" />
    {position && total && (
      <span class="Pagination-position">
        {String(position).padStart(2, "0")} / {total}
      </span>
    )}
  </LetterNavigation>
  {next && (
    <a
      class="Pagination-link Pagination-link--next"
      href={next}
      rel="next"
      title={nextTitle ?? t.nextLinkText}
      aria-label={nextTitle ?? t.nextLinkText}
    >
      <span class="Pagination-title">{nextTitle ?? t.nextLinkText}</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  )}
  {!next && <div class="Pagination-placeholder" />}
</nav>
