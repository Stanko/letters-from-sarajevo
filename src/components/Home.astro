---
import { translations, type Locale } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import Envelope from "./Envelope.astro";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = translations[lang];
---

<BaseLayout lang={lang} isHome>
  <div class="Home Container">
    <div class="Home-content">
      {t.home.paragraphs.map((paragraph) => (
        <p class="Home-text">{paragraph}</p>
      ))}
    </div>
    <div class="Home-invitation">
      <Envelope lang={lang} />
      <p class="Home-dedication">{t.home.dedication}</p>
    </div>
  </div>
</BaseLayout>
