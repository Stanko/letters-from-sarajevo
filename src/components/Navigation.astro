---
import LanguageSelector from "./LanguageSelector.astro";
import {
  homeUrl,
  translations,
  type Locale,
  type LocalizedLink,
} from "../i18n";

interface Props {
  lang: Locale;
  title: string;
  alternates?: LocalizedLink[];
}
const { lang, title, alternates } = Astro.props;
---

<header class="Navigation">
  <nav class="Navigation-content">
    <a class="Navigation-link" href={homeUrl(lang)}>
      {translations[lang].title}
    </a>
    <span class="Navigation-separator" aria-hidden="true">
      &bull;
    </span>
    <span class="Navigation-title">{title}</span>
    <LanguageSelector lang={lang} alternates={alternates} />
  </nav>
</header>
