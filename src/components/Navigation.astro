---
import { Image } from "astro:assets";
import tadija from "../assets/letter-02/tadija-1.png";
import {
  homeUrl,
  aboutUrl,
  translations,
  type Locale,
  type LocalizedLink,
} from "../i18n";
import LanguageSelector from "./LanguageSelector.astro";
import LetterNavigation from "./LetterNavigation.astro";

interface Props {
  lang: Locale;
  title?: string;
  alternates?: LocalizedLink[];
}

const { lang, title, alternates } = Astro.props;
const t = translations[lang];
---

<header class="Navigation">
  <nav class="Navigation-content Container">
    <div>
      {title ? (
        <>
          <a class="Navigation-title" href={homeUrl(lang)}>
            {t.home.title}
          </a>
          <h1 class="Navigation-subtitle">{title}</h1>
        </>
      ) : (
        <>
          <h1 class="Navigation-title">
            <a href={homeUrl(lang)}>{t.home.title}</a>
          </h1>
          <div class="Navigation-subtitle">{t.home.author}</div>
        </>
      )}
    </div>

    <div class="Navigation-menu">
      <LetterNavigation lang={lang} />

      <a href={aboutUrl(lang)} class="Navigation-item">
        {t.aboutText}{" "}
        <Image
          layout="none"
          loading="eager"
          src={tadija}
          decoding="sync"
          alt=""
        />
      </a>

      <LanguageSelector
        className="Navigation-item"
        lang={lang}
        alternates={alternates}
      />
    </div>
  </nav>
</header>
