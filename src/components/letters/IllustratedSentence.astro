---
import { Image } from "astro:assets";
import type { LetterData } from "../../lib/book";
interface Props {
  parts: Extract<LetterData, { template: "letter-two" }>["header"];
  spaced?: boolean;
}
const { parts, spaced = true } = Astro.props;
const separator = spaced ? " " : "";
---

<div class="Sentence">
  {parts.map((part) => (
    <Fragment>
      {typeof part === "string" && <span>{part}</span>}
      {typeof part !== "string" && (
        <div
          class:list={[
            "Sentence-imageWrapper",
            part.modifier && `Sentence-imageWrapper--${part.modifier}`,
          ]}
        >
          <Image
            layout="none"
            class="Sentence-image"
            style={`--image-ratio: ${part.image.width / part.image.height}`}
            src={part.image}
            alt={part.alt}
          />
        </div>
      )}
      {separator}
    </Fragment>
  ))}
</div>
