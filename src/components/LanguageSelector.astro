---
import { Image } from "astro:assets";
import earth from "../assets/earth.png";
import enFlag from "../assets/flags/en.svg";
import srFlag from "../assets/flags/sr.svg";
import ruFlag from "../assets/flags/ru.svg";
import ptBrFlag from "../assets/flags/pt-br.svg";
import elFlag from "../assets/flags/el.svg";
import huFlag from "../assets/flags/hu.svg";
import zhFlag from "../assets/flags/zh.svg";
import {
  homeUrl,
  languages,
  translations,
  type Locale,
  type LocalizedLink,
} from "../i18n";

interface Props {
  lang: Locale;
  alternates?: LocalizedLink[];
  className?: string;
  id?: string;
  showIcon?: boolean;
}

const {
  lang,
  alternates,
  className = "",
  id = "language",
  showIcon = true,
} = Astro.props;
const t = translations[lang];
const currentLanguage = languages.find(({ code }) => code === lang);
const flags = {
  en: enFlag,
  sr: srFlag,
  ru: ruFlag,
  "pt-br": ptBrFlag,
  el: elFlag,
  hu: huFlag,
  zh: zhFlag,
};
---

<div class="LanguageSelector" data-language-selector>
  <button
    id={`${id}-button`}
    class:list={["LanguageSelector-button", className]}
    type="button"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls={`${id}-menu`}
  >
    {currentLanguage?.label}
    {showIcon && (
      <Image decoding="sync" layout="none" loading="eager" src={earth} alt="" />
    )}
  </button>
  <nav
    id={`${id}-menu`}
    class="LanguageSelector-menu"
    aria-label={t.language}
    hidden
  >
    {languages.map(({ code, label }) => (
      <a
        href={
          alternates?.find((link) => link.lang === code)?.href ?? homeUrl(code)
        }
        lang={code}
        hreflang={code}
        aria-current={code === lang ? "page" : undefined}
        class:list={[
          "LanguageSelector-link",
          { "LanguageSelector-link--current": code === lang },
        ]}
      >
        <Image
          layout="none"
          loading="eager"
          class="LanguageSelector-flag"
          src={flags[code]}
          alt=""
        />
        {label}
      </a>
    ))}
  </nav>
  <noscript>
    <style is:inline>
      .LanguageSelector-menu[hidden] {
        display: flex;
        position: relative;
      }
      .LanguageSelector-button {
        display: none;
      }
    </style>
  </noscript>
</div>

<script>
  import { initDropdown } from "../scripts/dropdown";

  document
    .querySelectorAll<HTMLElement>("[data-language-selector]")
    .forEach(initDropdown);
</script>
