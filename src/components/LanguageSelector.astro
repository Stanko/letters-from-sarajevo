---
import { Image } from "astro:assets";
import Dropdown from "./Dropdown.astro";
import earth from "../assets/earth.png";
import enFlag from "../assets/flags/en.svg";
import srFlag from "../assets/flags/sr.svg";
import ruFlag from "../assets/flags/ru.svg";
import ptBrFlag from "../assets/flags/pt-br.svg";
import elFlag from "../assets/flags/el.svg";
import huFlag from "../assets/flags/hu.svg";
import zhFlag from "../assets/flags/zh.svg";
import {
  homeUrl,
  languages,
  translations,
  type Locale,
  type LocalizedLink,
} from "../i18n";

interface Props {
  lang: Locale;
  alternates?: LocalizedLink[];
  className?: string;
  id?: string;
  showIcon?: boolean;
}

const {
  lang,
  alternates,
  className = "",
  id = "language",
  showIcon = true,
} = Astro.props;
const t = translations[lang];
const currentLanguage = languages.find(({ code }) => code === lang);
const flags = {
  en: enFlag,
  sr: srFlag,
  ru: ruFlag,
  "pt-br": ptBrFlag,
  el: elFlag,
  hu: huFlag,
  zh: zhFlag,
};
---

<Dropdown
  id={id}
  label={t.language}
  className="LanguageSelector"
  buttonClassName={`LanguageSelector-button ${className}`}
  menuClassName="LanguageSelector-menu"
>
  <Fragment slot="button">
    {currentLanguage?.label}
    {showIcon && (
      <Image decoding="sync" layout="none" loading="eager" src={earth} alt="" />
    )}
  </Fragment>
  {languages.map(({ code, label }) => (
    <a
      href={
        alternates?.find((link) => link.lang === code)?.href ?? homeUrl(code)
      }
      lang={code}
      hreflang={code}
      aria-current={code === lang ? "page" : undefined}
      class:list={[
        "Dropdown-link LanguageSelector-link",
        { "LanguageSelector-link--current": code === lang },
      ]}
    >
      <Image
        layout="none"
        loading="eager"
        class="LanguageSelector-flag"
        src={flags[code]}
        alt=""
      />
      {label}
    </a>
  ))}
</Dropdown>
