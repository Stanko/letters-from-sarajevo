---
import { Image } from "astro:assets";
import translationIcon from "../assets/translation.svg";
import enFlag from "../assets/flags/en.svg";
import srFlag from "../assets/flags/sr.svg";
import ruFlag from "../assets/flags/ru.svg";
import ptBrFlag from "../assets/flags/pt-br.svg";
import elFlag from "../assets/flags/el.svg";
import {
  homeUrl,
  languages,
  translations,
  type Locale,
  type LocalizedLink,
} from "../i18n";

interface Props {
  lang: Locale;
  alternates?: LocalizedLink[];
}
const { lang, alternates } = Astro.props;
const t = translations[lang];
const flags = {
  en: enFlag,
  sr: srFlag,
  ru: ruFlag,
  "pt-br": ptBrFlag,
  el: elFlag,
};
---

<div class="LanguageSelector" data-language-selector>
  <button
    id="language-button"
    class="LanguageSelector-button"
    type="button"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="language-menu"
  >
    <Image
      layout="none"
      loading="eager"
      class="LanguageSelector-icon"
      src={translationIcon}
      alt=""
    />
    <span class="LanguageSelector-text">{t.language}</span>
  </button>
  <nav
    id="language-menu"
    class="LanguageSelector-menu"
    aria-label={t.language}
    hidden
  >
    {languages.map(({ code, label }) => (
      <a
        href={
          alternates?.find((link) => link.lang === code)?.href ?? homeUrl(code)
        }
        lang={code}
        hreflang={code}
        aria-current={code === lang ? "page" : undefined}
        class:list={[
          "LanguageSelector-link",
          { "LanguageSelector-link--current": code === lang },
        ]}
      >
        <Image
          layout="none"
          loading="eager"
          class="LanguageSelector-flag"
          src={flags[code]}
          alt=""
        />
        {label}
      </a>
    ))}
  </nav>
  <noscript>
    <style is:inline>
      #language-menu[hidden] {
        display: flex;
        position: relative;
      }
      #language-button {
        display: none;
      }
    </style>
  </noscript>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-language-selector]")
    .forEach((selector) => {
      const button = selector.querySelector("button");
      const menu = selector.querySelector("nav");

      if (!button || !menu) {
        return;
      }

      const links = Array.from(menu.querySelectorAll("a"));

      const setExpanded = (expanded: boolean) => {
        if (!expanded && menu.contains(document.activeElement)) {
          button.focus();
        }

        button.setAttribute("aria-expanded", String(expanded));
        menu.hidden = !expanded;
      };

      menu.setAttribute("role", "menu");
      menu.setAttribute("aria-labelledby", button.id);
      links.forEach((link) => {
        link.setAttribute("role", "menuitem");
        link.tabIndex = -1;
        link.addEventListener("click", () => setExpanded(false));
      });

      setExpanded(false);

      button.addEventListener("click", () => {
        const expanded = button.getAttribute("aria-expanded") === "false";
        setExpanded(expanded);

        if (expanded) {
          links[0]?.focus();
        }
      });

      button.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          setExpanded(true);
          const index = event.key === "ArrowUp" ? links.length - 1 : 0;
          links[index]?.focus();
        }
      });

      menu.addEventListener("keydown", (event) => {
        if (event.ctrlKey || event.altKey || event.metaKey) {
          return;
        }

        if (event.key === "Escape" || event.key === "Tab") {
          setExpanded(false);

          if (event.key === "Escape" || event.shiftKey) {
            event.preventDefault();
          }
          return;
        }

        const index = links.findIndex(
          (link) => link === document.activeElement,
        );

        if (event.key === " ") {
          event.preventDefault();
          links[index]?.click();
          return;
        }

        let nextIndex = index;

        if (event.key === "ArrowDown") {
          nextIndex = (index + 1) % links.length;
        } else if (event.key === "ArrowUp") {
          nextIndex = (index - 1 + links.length) % links.length;
        } else if (event.key === "Home") {
          nextIndex = 0;
        } else if (event.key === "End") {
          nextIndex = links.length - 1;
        } else {
          return;
        }

        event.preventDefault();
        links[nextIndex]?.focus();
      });

      selector.addEventListener("focusout", (event) => {
        if (
          event.relatedTarget instanceof Node &&
          !selector.contains(event.relatedTarget)
        ) {
          setExpanded(false);
        }
      });

      document.addEventListener("click", (event) => {
        if (event.target instanceof Node && !selector.contains(event.target))
          setExpanded(false);
      });
    });
</script>
