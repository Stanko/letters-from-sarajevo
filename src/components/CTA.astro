---
import { Image } from "astro:assets";
import letterOpen from "../assets/letter-open.png";

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a class="CTA" href={href} lang="en">
  <Image layout="none" class="CTA-icon" src={letterOpen} alt="" />
  <span class="CTA-text">Read the first letter</span>
</a>
